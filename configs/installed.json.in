{
  "device": "/dev/video10",
  "model": "@CMAKE_INSTALL_PREFIX@/share/edgevision/models/yolov5s-640-640.rknn",
  "width": 640,
  "height": 480,
  "fps": 30,
  "preprocess": "cpu",
  "output_activation": "logits",
  "threshold": 0.35,
  "nms": 0.45,
  "queue": 2,
  "pool": 12,
  "video": true,
  "bitrate": 2000000,
  "rtsp_port": 8554,
  "port": 9000,
  "output": "/var/lib/edgevision",
  "event_confirm": 3,
  "event_pre": 3,
  "event_tail": 5,
  "roi": [
    0,
    0,
    1,
    1
  ],
  "run_seconds": 0,
  "infer_delay_ms": 0,
  "synthetic": false,
  "native_outputs": true,
  "replay_yuyv": "",
  "infer_slow_ms": 150,
  "infer_stall_ms": 2000,
  "infer_max_age_ms": 500,
  "infer_degraded_interval_ms": 200,
  "allow_fault_injection": false,
  "record_max_mb": 256,
  "record_max_files": 128,
  "record_min_free_mb": 64,
  "record_max_seconds": 60
}
